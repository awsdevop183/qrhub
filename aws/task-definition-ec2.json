{
  "family": "qrhub-ec2-task",
  "networkMode": "bridge",
  "requiresCompatibilities": ["EC2"],
  "executionRoleArn": "arn:aws:iam::016933545181:role/qrhubExecutionRole",
  "taskRoleArn": "arn:aws:iam::016933545181:role/qrhubTaskRole",
  "containerDefinitions": [
    {
      "name": "qrhub",
      "image": "016933545181.dkr.ecr.us-east-1.amazonaws.com/qrhub:v2",
      "essential": true,
      "cpu": 256,
      "memoryReservation": 256,
      "memory": 512,
      "portMappings": [
        {
          "containerPort": 3000,
          "hostPort": 0,
          "protocol": "tcp"
        }
      ],
      "environment": [
        { "name": "APP_VERSION", "value": "v1" },
        { "name": "BANNER_MESSAGE", "value": "ECS on EC2 launch type - ap-south-1" }
      ],
      "secrets": [
        {
          "name": "QRHUB_SIGNING_KEY",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:016933545181:secret:QRHUB_SIGNING_KEY-Z6jQlK::"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/qrhub-ec2",
          "awslogs-region": "ap-south-1",
          "awslogs-stream-prefix": "ecs",
          "awslogs-create-group": "true"
        }
      }
    }
  ]
}
