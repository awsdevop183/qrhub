# Copy to .env and fill in. Never commit .env.
#
#   docker run --env-file .env -p 3000:3000 qrhub:v1

# REQUIRED. HMAC key used to sign every QR short link.
# Generate one with:  openssl rand -base64 32
# In ECS this is injected from Secrets Manager - never set it in the image.
QRHUB_SIGNING_KEY=

# Optional - shown in the UI, used for the rolling-deploy demo
APP_VERSION=v1
BANNER_MESSAGE=Running locally

# Optional - set to true to make /health fail (circuit breaker demo)
BREAK_HEALTH=false

# Optional - port the app listens on inside the container
PORT=3000

# Optional - overrides the host used when building signed links.
# Set this when the public URL differs from the Host header the app sees,
# e.g. testing on an EC2 box:  http://<public-ip>:3000
PUBLIC_BASE_URL=
